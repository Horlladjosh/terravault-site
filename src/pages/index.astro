---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Terravault — Direct air capture, independently verified">
  <section
    class="tv-container"
    style="position:relative; padding:132px 64px 0; text-align:center; background:radial-gradient(ellipse 70% 50% at 50% -10%, rgba(157,242,122,0.16), transparent 60%), radial-gradient(ellipse 60% 40% at 85% 20%, rgba(29,158,117,0.12), transparent 60%), #090b09;"
  >
    <div style="max-width:900px; margin:0 auto;">
      <div
        data-reveal
        style="display:inline-flex; align-items:center; gap:8px; font-size:13px; color:#9ef27a; letter-spacing:0.03em; margin-bottom:28px; border:1px solid rgba(158,242,122,0.25); padding:7px 16px 7px 8px; border-radius:100px; background:rgba(158,242,122,0.06);"
      >
        <span
          style="width:6px; height:6px; border-radius:50%; background:#9ef27a; box-shadow:0 0 8px #9ef27a; display:block;"
        ></span>Direct air capture, independently verified
      </div>
      <h1
        data-reveal
        style="font-family:'Fraunces',serif; font-size:clamp(42px,6vw,70px); font-weight:500; letter-spacing:-0.02em; line-height:1.04; margin-bottom:26px;"
      >
        Removing carbon at <em style="font-style:italic; color:#9ef27a;">gigaton scale</em>,
        backed by third-party verification
      </h1>
      <p data-reveal style="font-size:19px; color:#a9a79d; max-width:560px; margin:0 auto 42px;">
        Terravault's modular DAC facilities pull CO&#8322; directly from the atmosphere for
        permanent mineral storage — engineered for enterprises that need removals they can
        defend.
      </p>
      <div data-reveal style="display:flex; gap:14px; justify-content:center; margin-bottom:84px; flex-wrap:wrap;">
        <a
          href="/technology"
          class="btn-primary"
          style="background:linear-gradient(135deg,#b4f792,#1d9e75); color:#06210f; padding:15px 28px; border-radius:100px; font-weight:700; font-size:15px;"
          >See the technology</a
        >
        <a
          href="/verification-report"
          class="btn-secondary"
          style="border:1px solid rgba(255,255,255,0.16); padding:15px 28px; border-radius:100px; font-weight:600; font-size:15px; color:#f4f2ec;"
          >Download verification report</a
        >
      </div>
    </div>

    <div
      data-reveal
      style="max-width:1280px; margin:0 auto; height:min(56vw,540px); border-radius:20px; position:relative; overflow:hidden; border:1px solid rgba(255,255,255,0.1);"
    >
      <img
        src="https://images.unsplash.com/photo-1508514177221-188b1cf16e9d?auto=format&fit=crop&w=1600&q=80"
        alt="Terravault direct air capture facility"
        style="width:100%; height:100%; object-fit:cover; filter:saturate(0.85) brightness(0.72);"
      />
      <div
        style="position:absolute; inset:0; background:linear-gradient(180deg,rgba(9,11,9,0) 38%,rgba(9,11,9,0.92) 100%), linear-gradient(90deg,rgba(9,11,9,0.5) 0%,transparent 42%);"
      >
      </div>
      <div class="tv-hero-badges-overlay">
        <div
          style="position:absolute; bottom:28px; left:32px; font-size:13.5px; color:#e5e3db; background:rgba(9,11,9,0.55); backdrop-filter:blur(6px); padding:9px 16px; border-radius:100px; border:1px solid rgba(255,255,255,0.12); display:flex; align-items:center; gap:8px;"
        >
          <span
            style="width:6px; height:6px; border-radius:50%; background:#9ef27a; box-shadow:0 0 8px #9ef27a; display:block;"
          ></span>Facility 02 — Permian Basin · live capture data
        </div>
        <div style="position:absolute; bottom:28px; right:32px; display:flex; gap:28px;">
          <div style="text-align:right;">
            <div style="font-size:22px; font-weight:700; color:#f4f2ec;">1,240</div>
            <div style="font-size:11.5px; color:#b8b6ac;">tons this month</div>
          </div>
          <div style="text-align:right;">
            <div style="font-size:22px; font-weight:700; color:#f4f2ec;">98.4%</div>
            <div style="font-size:11.5px; color:#b8b6ac;">uptime</div>
          </div>
        </div>
      </div>
    </div>

    <div
      class="tv-container tv-hero-badges-stacked"
      style="max-width:1280px; margin:16px auto 0; padding:0 64px; flex-direction:column; gap:16px; align-items:flex-start;"
    >
      <div
        style="font-size:13.5px; color:#e5e3db; background:rgba(255,255,255,0.04); padding:9px 16px; border-radius:100px; border:1px solid rgba(255,255,255,0.12); display:flex; align-items:center; gap:8px;"
      >
        <span
          style="width:6px; height:6px; border-radius:50%; background:#9ef27a; box-shadow:0 0 8px #9ef27a; display:block;"
        ></span>Facility 02 — Permian Basin · live capture data
      </div>
      <div style="display:flex; gap:28px;">
        <div>
          <div style="font-size:20px; font-weight:700; color:#f4f2ec;">1,240</div>
          <div style="font-size:11.5px; color:#b8b6ac;">tons this month</div>
        </div>
        <div>
          <div style="font-size:20px; font-weight:700; color:#f4f2ec;">98.4%</div>
          <div style="font-size:11.5px; color:#b8b6ac;">uptime</div>
        </div>
      </div>
    </div>
  </section>

  <div
    data-reveal
    class="tv-container-margin tv-grid-4"
    style="display:grid; grid-template-columns:repeat(4,1fr); gap:1px; background:rgba(255,255,255,0.07); margin:96px 64px; border-radius:14px; overflow:hidden;"
  >
    <div class="stat-cell" style="background:#0d100e; padding:40px 32px;">
      <div style="font-family:'Fraunces',serif; font-size:38px; font-weight:500; color:#9ef27a; letter-spacing:-0.01em;">
        412K
      </div>
      <div style="font-size:13.5px; color:#a9a79d; margin-top:8px;">Tons CO&#8322; captured to date</div>
    </div>
    <div class="stat-cell" style="background:#0d100e; padding:40px 32px;">
      <div style="font-family:'Fraunces',serif; font-size:38px; font-weight:500; color:#9ef27a; letter-spacing:-0.01em;">
        $180
      </div>
      <div style="font-size:13.5px; color:#a9a79d; margin-top:8px;">Cost per ton, 45Q eligible</div>
    </div>
    <div class="stat-cell" style="background:#0d100e; padding:40px 32px;">
      <div style="font-family:'Fraunces',serif; font-size:38px; font-weight:500; color:#9ef27a; letter-spacing:-0.01em;">
        99.9%
      </div>
      <div style="font-size:13.5px; color:#a9a79d; margin-top:8px;">Storage permanence, verified</div>
    </div>
    <div class="stat-cell" style="background:#0d100e; padding:40px 32px;">
      <div style="font-family:'Fraunces',serif; font-size:38px; font-weight:500; color:#9ef27a; letter-spacing:-0.01em;">
        14
      </div>
      <div style="font-size:13.5px; color:#a9a79d; margin-top:8px;">Enterprise offtake partners</div>
    </div>
  </div>

  <section style="position:relative; overflow:hidden; margin:20px 0; height:min(72vh,600px);">
    <video
      data-autovideo
      playsinline
      poster="https://images.pexels.com/videos/30282132/view-of-hyosung-gas-processing-plant-in-phu-my-town-30282132.jpeg?auto=compress&cs=tinysrgb&w=1600"
      style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; filter:saturate(0.9) brightness(0.6);"
      ><source
        src="https://videos.pexels.com/video-files/30282132/12981341_2560_1440_60fps.mp4"
        type="video/mp4"
      /></video
    >
    <div
      style="position:absolute; inset:0; background:linear-gradient(180deg,rgba(9,11,9,0.62) 0%,rgba(9,11,9,0.32) 45%,rgba(9,11,9,0.92) 100%), linear-gradient(90deg,rgba(9,11,9,0.55) 0%,transparent 55%);"
    >
    </div>
    <div
      class="tv-container"
      style="position:relative; height:100%; max-width:1280px; margin:0 auto; padding:0 64px; display:flex; flex-direction:column; justify-content:center;"
    >
      <div data-reveal style="max-width:600px;">
        <div style="font-size:13px; color:#9ef27a; letter-spacing:0.05em; margin-bottom:16px; font-weight:600;">
          In the field
        </div>
        <h2
          style="font-family:'Fraunces',serif; font-size:clamp(30px,4.6vw,52px); font-weight:500; letter-spacing:-0.02em; line-height:1.05; margin-bottom:18px;"
        >
          Removal that stays removed — built in the real world
        </h2>
        <p style="font-size:17px; color:#c8c6bd; max-width:460px;">
          Four facilities across three continents, pulling carbon from the air today and turning
          it to stone underground.
        </p>
      </div>
    </div>
    <div
      style="position:absolute; bottom:22px; right:28px; font-size:11px; color:#8a887f; background:rgba(9,11,9,0.4); padding:5px 12px; border-radius:100px; backdrop-filter:blur(4px);"
    >
      Aerial facility footage · Pexels
    </div>
  </section>

  <section class="tv-container" style="max-width:1280px; margin:0 auto; padding:100px 64px;">
    <div data-reveal style="max-width:640px; margin-bottom:60px;">
      <div style="font-size:13px; color:#9ef27a; letter-spacing:0.05em; margin-bottom:16px; font-weight:600;">
        How it works
      </div>
      <h2 style="font-family:'Fraunces',serif; font-size:clamp(30px,4vw,42px); font-weight:500; letter-spacing:-0.01em; margin-bottom:16px;">
        Three stages, one continuous process
      </h2>
      <p style="color:#a9a79d; font-size:17px;">
        From atmospheric intake to permanent mineralization, every ton is measured and
        independently verified.
      </p>
    </div>
    <div class="tv-grid-3" style="display:grid; grid-template-columns:repeat(3,1fr); gap:20px;">
      <div
        data-reveal
        class="card-lift"
        style="background:linear-gradient(160deg,#12160f,#0d100e); border:1px solid rgba(255,255,255,0.08); border-radius:16px; padding:32px;"
      >
        <div
          style="font-size:13px; color:#9ef27a; font-weight:700; margin-bottom:20px; width:32px; height:32px; border-radius:50%; background:rgba(158,242,122,0.1); display:flex; align-items:center; justify-content:center;"
        >
          01
        </div>
        <h3 style="font-size:19px; font-weight:700; margin-bottom:12px;">Atmospheric capture</h3>
        <p style="color:#918f86; font-size:14.5px;">
          Modular contactors pull ambient air through a solid sorbent bed, binding CO&#8322;
          molecules at the surface.
        </p>
      </div>
      <div
        data-reveal
        class="card-lift"
        style="background:linear-gradient(160deg,#12160f,#0d100e); border:1px solid rgba(255,255,255,0.08); border-radius:16px; padding:32px;"
      >
        <div
          style="font-size:13px; color:#9ef27a; font-weight:700; margin-bottom:20px; width:32px; height:32px; border-radius:50%; background:rgba(158,242,122,0.1); display:flex; align-items:center; justify-content:center;"
        >
          02
        </div>
        <h3 style="font-size:19px; font-weight:700; margin-bottom:12px;">Thermal release</h3>
        <p style="color:#918f86; font-size:14.5px;">
          Low-grade waste heat regenerates the sorbent, releasing a concentrated CO&#8322; stream
          for processing.
        </p>
      </div>
      <div
        data-reveal
        class="card-lift"
        style="background:linear-gradient(160deg,#12160f,#0d100e); border:1px solid rgba(255,255,255,0.08); border-radius:16px; padding:32px;"
      >
        <div
          style="font-size:13px; color:#9ef27a; font-weight:700; margin-bottom:20px; width:32px; height:32px; border-radius:50%; background:rgba(158,242,122,0.1); display:flex; align-items:center; justify-content:center;"
        >
          03
        </div>
        <h3 style="font-size:19px; font-weight:700; margin-bottom:12px;">Mineral storage</h3>
        <p style="color:#918f86; font-size:14.5px;">
          CO&#8322; is combined with basalt formations, converting to stable carbonate minerals
          within two years.
        </p>
      </div>
    </div>
  </section>

  <section class="tv-container" style="max-width:1280px; margin:0 auto; padding:40px 64px 20px;">
    <div
      data-reveal
      style="position:relative; height:min(46vw,420px); border-radius:20px; overflow:hidden; border:1px solid rgba(255,255,255,0.1);"
    >
      <img
        src="https://images.pexels.com/photos/2569842/pexels-photo-2569842.jpeg?auto=compress&cs=tinysrgb&w=1600"
        alt="Terravault process hall"
        style="width:100%; height:100%; object-fit:cover; filter:saturate(0.82) brightness(0.6);"
        onerror="this.style.display='none'"
      />
      <div
        style="position:absolute; inset:0; background:linear-gradient(180deg,rgba(9,11,9,0.18) 25%,rgba(9,11,9,0.82) 100%), linear-gradient(90deg,rgba(9,11,9,0.5) 0%,transparent 52%);"
      >
      </div>
      <div style="position:absolute; bottom:28px; left:32px; max-width:520px;">
        <div style="font-size:12.5px; text-transform:uppercase; letter-spacing:0.06em; color:#9ef27a; margin-bottom:8px;">
          The hardware
        </div>
        <div style="font-family:'Fraunces',serif; font-size:clamp(18px,2.2vw,26px); color:#f4f2ec; line-height:1.35;">
          Modular contactors, engineered to be metered end to end.
        </div>
      </div>
    </div>
  </section>

  <section class="tv-container" style="max-width:1280px; margin:0 auto; padding:40px 64px 100px;">
    <div
      data-reveal
      style="border:1px solid rgba(255,255,255,0.08); border-radius:20px; overflow:hidden; background:linear-gradient(160deg,#0f130d,#0b0d0b);"
    >
      <div
        style="display:flex; justify-content:space-between; align-items:center; padding:24px 32px; border-bottom:1px solid rgba(255,255,255,0.07); flex-wrap:wrap; gap:16px;"
      >
        <div style="display:flex; align-items:center; gap:10px; font-size:14px; color:#e5e3db;">
          <span
            style="width:7px; height:7px; border-radius:50%; background:#9ef27a; box-shadow:0 0 10px #9ef27a; display:block;"
          ></span>Network capture — last 30 days
        </div>
        <div style="font-size:12.5px; color:#6b6960; letter-spacing:0.04em; text-transform:uppercase;">
          Updated hourly · MRV-linked
        </div>
      </div>
      <div class="tv-split" style="display:grid; grid-template-columns:1.4fr 1fr; gap:0;">
        <div style="padding:36px 32px; border-right:1px solid rgba(255,255,255,0.07);">
          <div style="font-size:13px; color:#918f86; margin-bottom:24px;">
            Tons captured per day, all facilities
          </div>
          <div style="display:flex; align-items:flex-end; gap:8px; height:150px;">
            <div style="flex:1; background:linear-gradient(180deg,#9ef27a,#1d9e75); border-radius:5px 5px 0 0; height:52%;"></div>
            <div style="flex:1; background:linear-gradient(180deg,#9ef27a,#1d9e75); border-radius:5px 5px 0 0; height:64%;"></div>
            <div style="flex:1; background:linear-gradient(180deg,#9ef27a,#1d9e75); border-radius:5px 5px 0 0; height:58%;"></div>
            <div style="flex:1; background:linear-gradient(180deg,#9ef27a,#1d9e75); border-radius:5px 5px 0 0; height:76%;"></div>
            <div style="flex:1; background:linear-gradient(180deg,#9ef27a,#1d9e75); border-radius:5px 5px 0 0; height:70%;"></div>
            <div style="flex:1; background:linear-gradient(180deg,#9ef27a,#1d9e75); border-radius:5px 5px 0 0; height:88%;"></div>
            <div style="flex:1; background:linear-gradient(180deg,#9ef27a,#1d9e75); border-radius:5px 5px 0 0; height:82%;"></div>
            <div style="flex:1; background:linear-gradient(180deg,#9ef27a,#1d9e75); border-radius:5px 5px 0 0; height:100%;"></div>
          </div>
          <div style="display:flex; justify-content:space-between; margin-top:12px; font-size:11px; color:#6b6960;">
            <span>Wk 1</span><span>Wk 2</span><span>Wk 3</span><span>Wk 4</span>
          </div>
        </div>
        <div style="padding:36px 32px; display:flex; flex-direction:column; gap:28px;">
          <div>
            <div style="font-family:'Fraunces',serif; font-size:32px; color:#f4f2ec;">
              3,420 <span style="font-size:15px; color:#9ef27a; font-family:'Manrope';">↑ 12%</span>
            </div>
            <div style="font-size:13px; color:#918f86; margin-top:4px;">Tons captured, 30 days</div>
          </div>
          <div>
            <div style="font-family:'Fraunces',serif; font-size:32px; color:#f4f2ec;">4</div>
            <div style="font-size:13px; color:#918f86; margin-top:4px;">Facilities online</div>
          </div>
          <div>
            <div style="font-family:'Fraunces',serif; font-size:32px; color:#f4f2ec;">97.8%</div>
            <div style="font-size:13px; color:#918f86; margin-top:4px;">Fleet uptime</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="tv-container" style="max-width:1280px; margin:0 auto; padding:80px 64px 40px;">
    <div data-reveal class="tv-split" style="display:grid; grid-template-columns:1.5fr 1fr; gap:36px; align-items:center;">
      <div
        style="position:relative; border-radius:20px; overflow:hidden; border:1px solid rgba(255,255,255,0.1); aspect-ratio:16/9; background:#0d100e;"
      >
        <video
          data-clip
          controls
          playsinline
          poster="https://images.pexels.com/videos/29941033/solar-power-29941033.jpeg?auto=compress&cs=tinysrgb&w=1600"
          style="width:100%; height:100%; object-fit:cover; display:block;"
          ><source
            src="https://videos.pexels.com/video-files/29941033/12849972_2560_1440_30fps.mp4"
            type="video/mp4"
          /></video
        >
      </div>
      <div>
        <div style="font-size:13px; color:#9ef27a; letter-spacing:0.05em; margin-bottom:14px; font-weight:600;">
          Watch
        </div>
        <h2 style="font-family:'Fraunces',serif; font-size:clamp(26px,3.2vw,34px); font-weight:500; letter-spacing:-0.01em; margin-bottom:14px;">
          Inside a Terravault facility
        </h2>
        <p style="color:#a9a79d; font-size:16px; margin-bottom:16px;">
          A short look at how modular contactors, waste-heat regeneration, and basalt injection
          come together on site.
        </p>
        <div style="font-size:12.5px; color:#6b6960;">
          Placeholder b-roll via Pexels — swap for your facility footage.
        </div>
      </div>
    </div>
  </section>

  <section class="tv-container" style="max-width:1280px; margin:0 auto; padding:60px 64px 100px;">
    <div data-reveal style="max-width:920px; margin:0 auto; text-align:center;">
      <div
        style="font-family:'Fraunces',serif; font-style:italic; font-size:clamp(24px,3.4vw,34px); line-height:1.4; color:#f4f2ec; letter-spacing:-0.01em;"
      >
        "Terravault was the only removal partner whose MRV data survived our diligence
        unchanged. We contracted 40,000 tons before the round closed."
      </div>
      <div
        style="margin-top:28px; display:flex; align-items:center; justify-content:center; gap:12px; font-size:14px; color:#a9a79d;"
      >
        <span
          style="width:36px; height:36px; border-radius:50%; background:linear-gradient(135deg,#1d9e75,#0b3d2c); display:inline-flex; align-items:center; justify-content:center; font-weight:700; font-size:13px; color:#dff7cf;"
          >MR</span
        >Maya Reyes · Head of Sustainability, Northbridge Capital
      </div>
    </div>
  </section>

  <div
    data-reveal
    class="tv-container"
    style="padding:56px 64px; border-top:1px solid rgba(255,255,255,0.07); border-bottom:1px solid rgba(255,255,255,0.07);"
  >
    <div
      style="text-align:center; font-size:12.5px; color:#918f86; text-transform:uppercase; letter-spacing:0.08em; margin-bottom:32px;"
    >
      Verified and backed by
    </div>
    <div
      class="tv-trust-logos-static"
      style="display:flex; justify-content:center; gap:64px; color:#6b6960; font-size:15px; font-weight:700; flex-wrap:wrap;"
    >
      <span>Puro.earth</span><span>Breakthrough Energy</span><span>Gold Standard</span><span
        >Frontier</span
      ><span>Isometric</span>
    </div>
    <div class="tv-trust-logos-marquee">
      <div class="tv-marquee-track" style="color:#6b6960; font-size:15px; font-weight:700;">
        <span>Puro.earth</span><span>Breakthrough Energy</span><span>Gold Standard</span><span
          >Frontier</span
        ><span>Isometric</span>
        <span aria-hidden="true">Puro.earth</span><span aria-hidden="true"
          >Breakthrough Energy</span
        ><span aria-hidden="true">Gold Standard</span><span aria-hidden="true">Frontier</span><span
          aria-hidden="true">Isometric</span
        >
      </div>
    </div>
  </div>

  <section class="tv-container" style="max-width:1280px; margin:0 auto; padding:60px 64px 40px;">
    <div data-reveal style="max-width:640px; margin-bottom:44px;">
      <div style="font-size:13px; color:#9ef27a; letter-spacing:0.05em; margin-bottom:14px; font-weight:600;">
        Go deeper
      </div>
      <h2 style="font-family:'Fraunces',serif; font-size:clamp(28px,3.6vw,40px); font-weight:500; letter-spacing:-0.01em; margin-bottom:14px;">
        Everything an evaluator needs, one click away
      </h2>
      <p style="color:#a9a79d; font-size:16px;">
        The science, the numbers, and the terms — all sourced and open to review.
      </p>
    </div>
    <div data-reveal class="tv-grid-3" style="display:grid; grid-template-columns:repeat(3,1fr); gap:20px;">
      <a
        href="/technology"
        class="card-lift"
        style="border:1px solid rgba(255,255,255,0.08); border-radius:16px; background:linear-gradient(160deg,#12160f,#0d100e); padding:30px; display:block;"
      >
        <div style="font-size:12px; text-transform:uppercase; letter-spacing:0.06em; color:#9ef27a; margin-bottom:14px;">
          The science
        </div>
        <h3 style="font-size:19px; font-weight:700; margin-bottom:8px;">
          The technology <span style="color:#9ef27a;">→</span>
        </h3>
        <p style="color:#918f86; font-size:14px;">
          Process schematic, energy &amp; mass balance, performance, and spec.
        </p>
      </a>
